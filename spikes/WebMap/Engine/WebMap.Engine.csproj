<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    Spike: RoguelikeToolkit.World.Core compiled to browser-wasm (Mono interpreter, no workload needed),
    driven from a Web Worker through [JSExport]. Not part of the solution; see ../README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\RoguelikeToolkit.World.Core\RoguelikeToolkit.World.Core.csproj" />
  </ItemGroup>

</Project>
