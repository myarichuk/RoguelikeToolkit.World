<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RoguelikeToolkit.World.NameTester.NameTesterWindow"
        Title="Name Generator Tester"
        Width="960" Height="700"
        MinWidth="640" MinHeight="480"
        Background="#1E1E1E"
        RequestedThemeVariant="Dark">
    <Grid RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" Margin="8">
            <TabItem x:Name="TabPeople" Header="People">
                <Grid RowDefinitions="Auto,*">
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="CmbRace" MinWidth="150" ToolTip.Tip="Ancestry key (extend via YAML)"/>
                        <ComboBox x:Name="CmbCulture" MinWidth="150" ToolTip.Tip="Culture table key"/>
                        <ComboBox x:Name="CmbLineage" MinWidth="130" ToolTip.Tip="Lineage rule"/>
                        <CheckBox x:Name="ChkFeminine" Content="Feminine"/>
                        <ComboBox x:Name="CmbScript" MinWidth="110" ToolTip.Tip="Script: native or Latin transliteration"/>
                        <NumericUpDown x:Name="NumSeed" MinWidth="110" Minimum="0" Maximum="999999" Value="42" ToolTip.Tip="Seed"/>
                        <NumericUpDown x:Name="NumCount" MinWidth="80" Minimum="1" Maximum="50" Value="10" ToolTip.Tip="How many"/>
                        <TextBox x:Name="TxtInspired" MinWidth="180" Watermark="inspired by: blood, eagle" ToolTip.Tip="Comma-separated themes"/>
                        <Button x:Name="BtnGenPeople" Content="Generate"/>
                    </WrapPanel>
                    <ListBox Grid.Row="1" x:Name="LstPeople" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabPlaces" Header="Places">
                <Grid RowDefinitions="Auto,*">
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="CmbKind" MinWidth="130"/>
                        <ComboBox x:Name="CmbPlaceRace" MinWidth="150" ToolTip.Tip="Ancestry key (extend via YAML)"/>
                        <ComboBox x:Name="CmbPlaceCulture" MinWidth="150" ToolTip.Tip="Culture table key"/>
                        <ComboBox x:Name="CmbPlaceScript" MinWidth="110" ToolTip.Tip="Script: native or Latin transliteration"/>
                        <CheckBox x:Name="ChkWater" Content="Water"/>
                        <CheckBox x:Name="ChkForest" Content="Forest"/>
                        <CheckBox x:Name="ChkDark" Content="Dark"/>
                        <CheckBox x:Name="ChkHigh" Content="High"/>
                        <CheckBox x:Name="ChkValley" Content="Valley"/>
                        <CheckBox x:Name="ChkDeposit" Content="Deposit"/>
                        <CheckBox x:Name="ChkDanger" Content="Danger"/>
                        <NumericUpDown x:Name="NumPlaceSeed" MinWidth="110" Minimum="0" Maximum="999999" Value="42"/>
                        <NumericUpDown x:Name="NumPlaceCount" MinWidth="80" Minimum="1" Maximum="50" Value="10"/>
                        <TextBox x:Name="TxtPlaceInspired" MinWidth="160" Watermark="inspired by"/>
                        <Button x:Name="BtnGenPlaces" Content="Generate"/>
                    </WrapPanel>
                    <ListBox Grid.Row="1" x:Name="LstPlaces" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="10,0,10,10">
            <TextBlock x:Name="TxtDataDir" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Text="data: "/>
            <Button x:Name="BtnReload" Content="Reload YAML" ToolTip.Tip="Re-extract missing files, reload overrides from disk"/>
            <TextBlock x:Name="TxtLanguage" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Text="Language"/>
            <ComboBox x:Name="CmbUiLanguage" MinWidth="130"/>
        </StackPanel>
    </Grid>
</Window>
