<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Documentation ratchet: every public member is documented and every cref resolves; regressions fail the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574;CS1570;CS1572;CS1573;CS1587</WarningsAsErrors>
    <!-- RS0026/RS0027: PublicApiAnalyzers backcompat guidance about optional-parameter overloads (World.GetRegion/GetLocal, SpatialIndex.NearestDeposit, ...).
         Those shapes predate the baseline and changing them is an API redesign, not a docs fix. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    <PackageId>RoguelikeToolkit.World.Core</PackageId>
    <Version>3.2.0</Version>
    <Authors>RoguelikeToolkit</Authors>
    <Description>Spherical hex world generation for RPG/roguelike games: tectonics, elevation, hydrology, climate, biomes, regions, city-site queries, and history hooks.</Description>
    <PackageTags>roguelike;rpg;worldgen;hex;procedural</PackageTags>
    <RepositoryUrl>https://github.com/myarichuk/RoguelikeToolkit.World</RepositoryUrl>
    <!-- Dual license: PolyForm Noncommercial 1.0.0 (free) + commercial (see LICENSE-COMMERCIAL.md). -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false"/>
    <None Include="..\..\LICENSE-COMMERCIAL.md" Pack="true" PackagePath="\" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="YamlDotNet" Version="18.1.0"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RoguelikeToolkit.World.Core.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Names\Data\*.yaml"/>
    <EmbeddedResource Include="Peoples\Data\**\*.yaml"/>
    <EmbeddedResource Include="Localization\*.yaml"/>
    <EmbeddedResource Include="Chronicle\Data\**\*.yaml"/>
  </ItemGroup>

</Project>
