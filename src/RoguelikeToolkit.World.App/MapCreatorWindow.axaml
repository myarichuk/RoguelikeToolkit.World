<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoguelikeToolkit.World.App"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
        x:Class="RoguelikeToolkit.World.App.MapCreatorWindow"
        Title="Map Creator - Tolkien-style world maps"
        Width="1000" Height="620"
        Background="#1E1E1E">

    <Grid ColumnDefinitions="*, 300">
        <Border Grid.Column="0" Margin="10" Background="#e9d9a6" CornerRadius="4">
            <local:MapPreviewControl x:Name="MapPreview" />
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="8" Margin="10">
                <TextBlock Text="Map Creator" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>

                <TextBlock Text="Map title:" Foreground="White"/>
                <TextBox x:Name="TxtTitle" Text="The Known World"/>

                <TextBlock Text="World Seed:" Foreground="White"/>
                <NumericUpDown x:Name="NumSeed" Minimum="1" Maximum="999999" Value="42"/>

                <TextBlock Text="Subdivision Level:" Foreground="White"/>
                <Slider x:Name="SldSize" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="TxtSize" Text="3" Foreground="LightGray" FontSize="12"/>

                <TextBlock Text="Plate Count:" Foreground="White"/>
                <Slider x:Name="SldPlates" Minimum="2" Maximum="30" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="TxtPlates" Text="12" Foreground="LightGray" FontSize="12"/>

                <TextBlock Text="Plate strategy:" Foreground="White"/>
                <ComboBox x:Name="CmbPartitioner" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem>Noisy flood-fill (organic)</ComboBoxItem>
                    <ComboBoxItem>Voronoi (classic)</ComboBoxItem>
                </ComboBox>

                <CheckBox x:Name="ChkSegment" Content="Segment mountain belts" IsChecked="True" Foreground="White"/>
                <CheckBox x:Name="ChkSmooth" Content="Smooth biome speckle" IsChecked="True" Foreground="White"/>

                <Button x:Name="BtnGenerate" Content="Generate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
                <Button x:Name="BtnExport" Content="Export SVG..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                <TextBlock x:Name="TxtStatus" Text="No world generated yet." Foreground="LightGray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
