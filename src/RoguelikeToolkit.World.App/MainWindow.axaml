<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoguelikeToolkit.World.App"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="RoguelikeToolkit.World.App.MainWindow"
        Title="RoguelikeToolkit World Visualizer"
        Background="#1E1E1E">

    <Grid>
        <!-- Container for hit testing -->
        <Border Background="Transparent"
                PointerPressed="GlViewContainer_PointerPressed"
                PointerReleased="GlViewContainer_PointerReleased"
                PointerMoved="GlViewContainer_PointerMoved"
                PointerWheelChanged="GlViewContainer_PointerWheelChanged">
            <!-- The OpenGL control for 3D rendering -->
            <local:GlControl x:Name="GlView" />
        </Border>

        <!-- Hex Info Overlay -->
        <Border Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Background="#80000000" Margin="10" Padding="10">
                <StackPanel Spacing="5">
                    <TextBlock Text="Selected Hex" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtHexLat" Text="Lat: --" Foreground="White"/>
                    <TextBlock x:Name="TxtHexLon" Text="Lon: --" Foreground="White"/>
                    <TextBlock x:Name="TxtHexIndex" Text="Index: --" Foreground="White"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Overlay UI -->
        <Border Padding="20" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <StackPanel Spacing="10" Background="#80000000">
                <TextBlock Text="Controls" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,5"/>

                <UniformGrid Columns="2" Rows="2">
                    <Button x:Name="BtnRotLeft" Content="Left" Background="#40FFFFFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="BtnRotRight" Content="Right" Background="#40FFFFFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="BtnRotUp" Content="Up" Background="#40FFFFFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="BtnRotDown" Content="Down" Background="#40FFFFFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </UniformGrid>

                <UniformGrid Columns="2" Rows="1">
                    <Button x:Name="BtnZoomIn" Content="Zoom In" Background="#40FFFFFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="BtnZoomOut" Content="Zoom Out" Background="#40FFFFFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </UniformGrid>

                <CheckBox x:Name="ChkTogglePlates" Content="Show Plates" IsChecked="True" Foreground="White" Margin="5"/>
                <CheckBox x:Name="ChkToggleHexes" Content="Show Hexes" IsChecked="False" Foreground="White" Margin="5"/>

                <TextBlock Text="Left-drag: Rotate" Foreground="LightGray" FontSize="12" Margin="5,0,0,0"/>
                <TextBlock Text="Right-drag: Pan" Foreground="LightGray" FontSize="12" Margin="5,0,0,0"/>
                <TextBlock Text="Scroll: Zoom" Foreground="LightGray" FontSize="12" Margin="5,0,0,5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
