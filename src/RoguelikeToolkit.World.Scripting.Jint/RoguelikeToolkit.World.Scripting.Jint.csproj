<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>RoguelikeToolkit.World.Scripting.Jint</PackageId>
    <Version>1.1.0</Version>
    <Authors>RoguelikeToolkit</Authors>
    <Description>Untrusted Jint (JavaScript) script stages for RoguelikeToolkit.World generation pipelines.</Description>
    <PackageTags>roguelike;rpg;worldgen;hex;procedural;jint;scripting</PackageTags>
    <RepositoryUrl>https://github.com/myarichuk/RoguelikeToolkit.World</RepositoryUrl>
    <!-- Dual license: PolyForm Noncommercial 1.0.0 (free) + commercial (see LICENSE-COMMERCIAL.md). -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false"/>
    <None Include="..\..\LICENSE-COMMERCIAL.md" Pack="true" PackagePath="\" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.2"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <!-- records/init on netstandard2.1 (Unity): same internal polyfills Core compiles in -->
    <Compile Include="..\RoguelikeToolkit.World.Core\Compat\CompilerPolyfills.cs" Link="Compat\CompilerPolyfills.cs"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoguelikeToolkit.World.Core\RoguelikeToolkit.World.Core.csproj"/>
  </ItemGroup>

</Project>
