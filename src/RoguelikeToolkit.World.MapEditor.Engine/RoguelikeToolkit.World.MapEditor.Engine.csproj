<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The map editor's world engine: RoguelikeToolkit.World.Core compiled to browser-wasm (Mono
    interpreter, no workload needed), driven from a Web Worker through [JSExport]. The editor
    front end (../RoguelikeToolkit.World.MapEditor) copies this project's published _framework.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoguelikeToolkit.World.Core\RoguelikeToolkit.World.Core.csproj" />
  </ItemGroup>

</Project>
