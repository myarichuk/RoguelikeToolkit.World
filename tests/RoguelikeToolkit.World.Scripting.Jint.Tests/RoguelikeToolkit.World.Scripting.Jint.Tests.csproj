<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- `dotnet test -p:CoreTargetFramework=netstandard2.1` runs against the Unity (netstandard2.1) builds. -->
    <ProjectReference Include="..\..\src\RoguelikeToolkit.World.Core\RoguelikeToolkit.World.Core.csproj"
                      Condition="'$(CoreTargetFramework)' == ''" />
    <ProjectReference Include="..\..\src\RoguelikeToolkit.World.Scripting.Jint\RoguelikeToolkit.World.Scripting.Jint.csproj"
                      Condition="'$(CoreTargetFramework)' == ''" />
    <ProjectReference Include="..\..\src\RoguelikeToolkit.World.Core\RoguelikeToolkit.World.Core.csproj"
                      SetTargetFramework="TargetFramework=$(CoreTargetFramework)"
                      Condition="'$(CoreTargetFramework)' != ''" />
    <ProjectReference Include="..\..\src\RoguelikeToolkit.World.Scripting.Jint\RoguelikeToolkit.World.Scripting.Jint.csproj"
                      SetTargetFramework="TargetFramework=$(CoreTargetFramework)"
                      Condition="'$(CoreTargetFramework)' != ''" />
  </ItemGroup>

</Project>
