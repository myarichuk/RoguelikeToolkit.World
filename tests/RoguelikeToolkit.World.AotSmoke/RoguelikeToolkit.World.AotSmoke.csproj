<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AOT smoke test: published with NativeAOT (no JIT, no Reflection.Emit, no runtime generic instantiation over
    value types, aggressive trimming), then run end to end. Stricter than Unity IL2CPP, so a pass is the CI proxy for
    "runs under IL2CPP". It prints a checksum of the generated world: the JIT run (dotnet run) and the native run
    must print the same value (determinism across code generators).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoguelikeToolkit.World.Core\RoguelikeToolkit.World.Core.csproj" />
  </ItemGroup>

</Project>
