<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- WorldExports is marked browser-only for the wasm host; here it runs on the host runtime on purpose. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The [JSExport] methods are ordinary statics; the editor's engine is exercised here on the host runtime. -->
    <ProjectReference Include="..\..\src\RoguelikeToolkit.World.MapEditor.Engine\RoguelikeToolkit.World.MapEditor.Engine.csproj" />
    <ProjectReference Include="..\..\samples\HistoryPlugin\HistoryPlugin.csproj" />
    <ProjectReference Include="..\..\samples\EconomyPlugin\EconomyPlugin.csproj" />
  </ItemGroup>

</Project>
